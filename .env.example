VERA_DATABASE_PATH=data/vera.db
VERA_MODEL_ENABLED=true
# Provider-qualified PydanticAI model IDs, primary first, comma-separated.
VERA_MODELS=google:gemini-3.7-flash,google:gemini-3.6-flash
VERA_MODEL_TIMEOUT_SECONDS=6
VERA_MODEL_OUTPUT_RETRIES=1
VERA_EVALUATION_NO_URLS=true
VERA_STRICT_EXPIRY=false
VERA_MAX_ACTIONS_PER_TICK=20
VERA_TEAM_NAME=RisingStar
VERA_TEAM_MEMBERS=Krrish Rastogi
VERA_CONTACT_EMAIL=krrishrastogi00@gmail.com
VERA_VERSION=0.1.1
VERA_SUBMITTED_AT=not-submitted
# Create this in Google AI Studio. Never commit your real key.
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
